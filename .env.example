# Copy this file to .env and fill in the real values.
# .env is gitignored - never commit the real token.
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-botfather-token
TELEGRAM_BOT_USERNAME=your_bot_username
RAILWAY_BASE_URL=https://eticket.railway.uz
# Optional: only needed if the railway.uz API rejects anonymous requests.
# Note the site's JWT expires after 1 hour, so a static token is a stopgap.
RAILWAY_AUTH_TOKEN=
